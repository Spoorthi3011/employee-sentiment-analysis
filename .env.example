# .env.example
# Copy this file to .env and fill in your values.
# The project works fully offline using the built-in lexicon sentiment analyser.
# These variables are only needed if you want to swap in an LLM-based labeller.

# Optional: Anthropic API key (for LLM-based sentiment labeling)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenAI API key (alternative LLM provider)
OPENAI_API_KEY=your_openai_api_key_here

# Data paths (defaults work if you keep the original project structure)
DATA_PATH=data/test_in_.csv
OUTPUT_PATH=data/test_labeled.csv
VIZ_PATH=visualizations/
